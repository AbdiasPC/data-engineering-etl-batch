# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Snowflake connection (key-pair auth) ---
# Account identifier in <orgname>-<account_name> form, without .snowflakecomputing.com
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=NYC_TAXI_SVC
# Path INSIDE the container. ./secrets on the host is mounted read-only at /run/secrets.
SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/rsa_key.p8
# Leave empty if the private key is not encrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Snowflake objects (must match sql/00_snowflake_setup.sql) ---
SNOWFLAKE_ROLE=NYC_TAXI_PIPELINE
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_STAGING_SCHEMA=STAGING
SNOWFLAKE_MARTS_SCHEMA=MARTS

# --- Pipeline scope (inclusive, YYYY-MM). CLI flags --start/--end override these. ---
PIPELINE_START_MONTH=2025-01
PIPELINE_END_MONTH=2025-03

# --- Weather location (New York City) ---
WEATHER_LATITUDE=40.7128
WEATHER_LONGITUDE=-74.0060
WEATHER_TIMEZONE=America/New_York

# --- Runtime ---
DATA_DIR=/app/data
LOG_LEVEL=INFO
